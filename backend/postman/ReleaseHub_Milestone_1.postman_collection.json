{
  "info": {
    "name": "ReleaseHub API",
    "description": "Postman collection for ReleaseHub Backend API (Health, Authentication, Changelog Admin, Public Timeline, Reactions, Notifications, User Profile & Admin Insights)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Get Health Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Check service and database readiness"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"StrongPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            },
            "description": "Register a new user and generate simulated email verification token"
          },
          "response": []
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<verification-token-from-signup>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-email",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-email"]
            },
            "description": "Confirm email address using verification token"
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"StrongPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticate user and set HTTP-only access and refresh cookies"
          },
          "response": []
        },
        {
          "name": "Get Current User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Retrieve currently authenticated user profile via cookie"
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Rotate refresh token and issue new token pair via HTTP-only cookie"
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "Clear access and refresh cookies and revoke refresh token in database"
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "forgot-password"]
            },
            "description": "Initiate password reset flow with generic enumeration-safe response"
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<reset-token-from-forgot-password>\",\n  \"password\": \"NewStrongPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset-password"]
            },
            "description": "Reset password using reset token and new password"
          },
          "response": []
        },
        {
          "name": "Admin Only Authorization Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/admin-only",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "admin-only"]
            },
            "description": "Verify endpoint access restricted to authenticated admin users"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Changelog Admin",
      "item": [
        {
          "name": "Create Changelog (Draft)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dark Mode & Performance Upgrades\",\n  \"contentMarkdown\": \"# Dark Mode\\nWe have introduced a sleek new dark theme across all dashboard views!\",\n  \"category\": \"new\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/changelog/admin",
              "host": ["{{baseUrl}}"],
              "path": ["changelog", "admin"]
            },
            "description": "Admin creates a new changelog entry. Status defaults to 'draft'."
          },
          "response": []
        },
        {
          "name": "List All Changelogs (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/changelog/admin?page=1&limit=10&status=draft&category=new&search=Dark",
              "host": ["{{baseUrl}}"],
              "path": ["changelog", "admin"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "draft" },
                { "key": "category", "value": "new" },
                { "key": "search", "value": "Dark" }
              ]
            },
            "description": "Admin lists all updates with optional status filter, category filter, keyword search, and pagination."
          },
          "response": []
        },
        {
          "name": "Get Changelog by ID (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/changelog/admin/:id",
              "host": ["{{baseUrl}}"],
              "path": ["changelog", "admin", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "<changelog-mongodb-id>"
                }
              ]
            },
            "description": "Admin retrieves a single changelog by its MongoDB ObjectId."
          },
          "response": []
        },
        {
          "name": "Update Changelog (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dark Mode & High Performance Engine\",\n  \"contentMarkdown\": \"# Dark Mode & Fast Rendering\\nUpdated notes with extra details!\",\n  \"category\": \"improved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/changelog/admin/:id",
              "host": ["{{baseUrl}}"],
              "path": ["changelog", "admin", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "<changelog-mongodb-id>"
                }
              ]
            },
            "description": "Admin updates a changelog. If the title changes, a new unique slug is recalculated."
          },
          "response": []
        },
        {
          "name": "Publish Changelog (Admin)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/changelog/admin/:id/publish",
              "host": ["{{baseUrl}}"],
              "path": ["changelog", "admin", ":id", "publish"],
              "variable": [
                {
                  "key": "id",
                  "value": "<changelog-mongodb-id>"
                }
              ]
            },
            "description": "Admin publishes a draft changelog, setting status to 'published' and recording publishedAt timestamp."
          },
          "response": []
        },
        {
          "name": "Unpublish Changelog (Admin)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/changelog/admin/:id/unpublish",
              "host": ["{{baseUrl}}"],
              "path": ["changelog", "admin", ":id", "unpublish"],
              "variable": [
                {
                  "key": "id",
                  "value": "<changelog-mongodb-id>"
                }
              ]
            },
            "description": "Admin unpublishes a changelog, reverting status to 'draft' and clearing publishedAt."
          },
          "response": []
        },
        {
          "name": "Delete Changelog (Admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/changelog/admin/:id",
              "host": ["{{baseUrl}}"],
              "path": ["changelog", "admin", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "<changelog-mongodb-id>"
                }
              ]
            },
            "description": "Admin permanently deletes a changelog and cascades reaction deletions."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Public Changelog",
      "item": [
        {
          "name": "Get Public Changelog Timeline",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/changelog?page=1&limit=10&category=new&search=Dark",
              "host": ["{{baseUrl}}"],
              "path": ["changelog"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "category", "value": "new" },
                { "key": "search", "value": "Dark" }
              ]
            },
            "description": "Public timeline listing published changelogs sorted reverse-chronologically with reaction counters."
          },
          "response": []
        },
        {
          "name": "Get Public JSON Feed",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/changelog/feed",
              "host": ["{{baseUrl}}"],
              "path": ["changelog", "feed"]
            },
            "description": "Clean, unpaginated JSON feed of recent published product updates."
          },
          "response": []
        },
        {
          "name": "Get Published Changelog by Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/changelog/:slug",
              "host": ["{{baseUrl}}"],
              "path": ["changelog", ":slug"],
              "variable": [
                {
                  "key": "slug",
                  "value": "dark-mode-high-performance-engine"
                }
              ]
            },
            "description": "Public single-item view with safe author info, reaction counts, and user's reaction states if logged in."
          },
          "response": []
        },
        {
          "name": "Get Related Changelogs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/changelog/:slug/related?limit=3",
              "host": ["{{baseUrl}}"],
              "path": ["changelog", ":slug", "related"],
              "variable": [
                {
                  "key": "slug",
                  "value": "dark-mode-high-performance-engine"
                }
              ],
              "query": [
                { "key": "limit", "value": "3" }
              ]
            },
            "description": "Fetch published updates sharing the same category, excluding the current update."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Reactions",
      "item": [
        {
          "name": "Add Reaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"heart\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/changelog/:id/reactions",
              "host": ["{{baseUrl}}"],
              "path": ["changelog", ":id", "reactions"],
              "variable": [
                {
                  "key": "id",
                  "value": "<changelog-mongodb-id>"
                }
              ]
            },
            "description": "Authenticated user adds a reaction (heart, celebrate, rocket) to a published changelog."
          },
          "response": []
        },
        {
          "name": "Remove Reaction",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/changelog/:id/reactions/:type",
              "host": ["{{baseUrl}}"],
              "path": ["changelog", ":id", "reactions", ":type"],
              "variable": [
                {
                  "key": "id",
                  "value": "<changelog-mongodb-id>"
                },
                {
                  "key": "type",
                  "value": "heart"
                }
              ]
            },
            "description": "Authenticated user removes their specific reaction type from a changelog."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Get What's New Notifications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"]
            },
            "description": "Retrieve recent published changelog updates, overall unread count, and isUnread indicator per item."
          },
          "response": []
        },
        {
          "name": "Mark All Notifications as Read",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notifications/read",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "read"]
            },
            "description": "Update user's lastViewedChangelogDate to now, setting unread count to 0."
          },
          "response": []
        }
      ]
    },
    {
      "name": "User Profile",
      "item": [
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            },
            "description": "Retrieve profile fields (name, email, role, isEmailVerified, createdAt) without sensitive fields."
          },
          "response": []
        },
        {
          "name": "Update User Profile (Name)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Johnathan Doe\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            },
            "description": "Safely update user's name. Email and role remain read-only."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin Insights",
      "item": [
        {
          "name": "Get Admin Insights",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/insights",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "insights"]
            },
            "description": "Retrieve aggregated system metrics (changelog counts, reaction totals by type, user counts, recent activity)."
          },
          "response": []
        }
      ]
    }
  ]
}
